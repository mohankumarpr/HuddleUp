rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function orgIdOf(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.orgId;
    }

    function isOrgMember(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgIdOf(eventId))/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isOrgMemberOfOrg(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function teamRepDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/teamReps/$(request.auth.uid));
    }

    function isTeamRepFor(eventId, teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/teamReps/$(request.auth.uid)) &&
        teamRepDoc(eventId).data.teamId == teamId;
    }

    // The signed-in account's email (lowercased), if it has one. Anonymous accounts have none.
    function hasAuthEmail() {
      return isSignedIn() && 'email' in request.auth.token;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    // ---------- Users (uid -> orgId lookup, one row per account) ----------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Organizations ----------
    match /organizations/{orgId} {
      allow read: if isOrgMemberOfOrg(orgId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOrgOwner(orgId);

      match /members/{uid} {
        allow read: if isOrgMemberOfOrg(orgId);
        // Bootstrap: a user may create their own OWNER membership doc only when they also
        // own the parent org doc (both writes happen in one client-side batch on sign-up).
        // Co-organizer path: an invited (not-yet-member) account may instead create its own
        // 'organizer' membership by pointing at a pending invite doc whose email matches its own
        // sign-in email -- see acceptInvite() in utils/firebase/invites.js.
        allow create: if isSignedIn() && request.auth.uid == uid && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid ||
          (
            hasAuthEmail() &&
            request.resource.data.role == 'organizer' &&
            request.resource.data.inviteId is string &&
            get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(request.resource.data.inviteId)).data.emailLower == authEmailLower() &&
            get(/databases/$(database)/documents/organizations/$(orgId)/invites/$(request.resource.data.inviteId)).data.status == 'pending'
          )
        );
        allow update, delete: if isOrgOwner(orgId);
      }

      // Co-organizer invites: created by the owner, readable by ID (so the invite-acceptance
      // page works before the invitee has an account), accepted by the invitee themself.
      match /invites/{inviteId} {
        allow get: if true;
        allow list: if isOrgOwner(orgId);
        allow create: if isOrgOwner(orgId) && request.resource.data.status == 'pending';
        allow update: if
          (
            isOrgOwner(orgId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'revoked'
          ) || (
            hasAuthEmail() &&
            authEmailLower() == resource.data.emailLower &&
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy']) &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedBy == request.auth.uid
          );
        allow delete: if isOrgOwner(orgId);
      }
    }

    // ---------- Events (and everything scoped to one event) ----------
    match /events/{eventId} {
      allow read: if true; // public event landing, registration, spectator views
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)/members/$(request.auth.uid));
      allow update, delete: if isOrgMember(eventId);

      match /sports/{sportId} {
        allow read: if true;
        allow write: if isOrgMember(eventId);
      }

      match /teams/{teamId} {
        allow read: if true;
        allow create, delete: if isOrgMember(eventId);
        // Organizers manage the team doc; the only fields a team rep may ever touch directly are
        // purseRemaining (via the confirmSold transaction path) and bidWithdrawUsed (via
        // withdrawBid, and only to flip it on -- never back off).
        allow update: if isOrgMember(eventId) ||
          (isTeamRepFor(eventId, teamId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purseRemaining', 'bidWithdrawUsed']) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bidWithdrawUsed']) ||
              request.resource.data.bidWithdrawUsed == true));
      }

      match /registrations/{regId} {
        allow read, update, delete: if isOrgMember(eventId);
        // Public registration form, no login required -- so this is the one write path on the
        // whole site open to total strangers. Shape/size bounds stop garbage or huge payloads;
        // the optional honeypot field (see PublicRegistrationForm.jsx) catches bots simple enough
        // to auto-fill every input on the page. Neither stops a bot that crafts its own
        // Firestore write directly -- there's no server here to verify anything further.
        allow create: if request.resource.data.status == 'pending' &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
          (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 50)) &&
          (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200)) &&
          (!('block' in request.resource.data) || (request.resource.data.block is string && request.resource.data.block.size() <= 100)) &&
          (!('aboutMe' in request.resource.data) || (request.resource.data.aboutMe is string && request.resource.data.aboutMe.size() <= 1000)) &&
          (!('sportIds' in request.resource.data) || (request.resource.data.sportIds is list && request.resource.data.sportIds.size() <= 50)) &&
          (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null ||
            (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 450000)) &&
          (!('honeypot' in request.resource.data) || request.resource.data.honeypot == '');
      }

      match /players/{playerId} {
        allow read: if true;
        allow write: if isOrgMember(eventId);
      }

      // Email, phone and address of each player. Organizers manage it; a player can read only the
      // record whose email matches their own login (that is how they find their player record).
      match /playerPrivate/{playerId} {
        allow read: if isOrgMember(eventId) ||
          (hasAuthEmail() && resource.data.emailLower == authEmailLower());
        allow write: if isOrgMember(eventId);
      }

      // A login linked to an approved player. Creatable only when the account's email matches the
      // player's private record, so nobody can attach themselves to someone else's record.
      match /participants/{uid} {
        allow read: if isOrgMember(eventId) || (isSignedIn() && request.auth.uid == uid);
        allow create: if hasAuthEmail() && request.auth.uid == uid &&
          get(/databases/$(database)/documents/events/$(eventId)/playerPrivate/$(request.resource.data.playerId)).data.emailLower
            == authEmailLower();
        allow delete: if isOrgMember(eventId) || (isSignedIn() && request.auth.uid == uid);
      }

      // Manual points per sport per team. Standings are public, same as the sports schedule and
      // team list they're shown alongside -- anyone with the event link can look them up.
      match /results/{sportId} {
        allow read: if true;
        allow write: if isOrgMember(eventId);
      }

      // Round-robin fixtures generated from a sport's match format (events/{id}/sports/{id}
      // .matchFormat), with a winner recorded per match. Public read, same as the schedule it
      // belongs to; only the organizer generates fixtures or records results.
      match /fixtures/{fixtureId} {
        allow read: if true;
        allow write: if isOrgMember(eventId);
      }

      match /teamReps/{uid} {
        allow read: if isOrgMember(eventId) || request.auth.uid == uid;
        // Join flow: a signed-in (anonymous) user claims their own seat. PIN verification
        // happens client-side against the team doc before this write; a dishonest client could
        // skip that check, but can never grant itself an organizations/{orgId} membership, so
        // the worst case is bidding as a team it wasn't invited to -- which the organizer can
        // immediately undo by deleting this doc (kick/reset seat).
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if isOrgMember(eventId) || request.auth.uid == uid;
      }

      match /auction/state {
        allow read: if true; // every live-room view (organizer/bidder/spectator) listens here
        allow create: if isOrgMember(eventId);
        // Organizer: full control of status/currentPlayerId/etc.
        // Team rep placing a bid: may ONLY raise currentPrice on behalf of their own team, on a
        // live auction, for the same player, by exactly the fields a bid touches -- nothing else.
        // The very first bid on a player opens right at the base price (currentPrice doesn't move,
        // only currentHighBidTeamId does -- see nextBidAmount in auctionRealtime.js), so it's only
        // required to not go DOWN; every bid after that must strictly raise it.
        // Team rep withdrawing their own last bid: may ONLY lower currentPrice back down (or leave
        // it unchanged, undoing a first bid that never moved it off the base price), and only while
        // they're still the team on top and lastBid still points at their own bid -- see
        // withdrawBid in auctionRealtime.js.
        allow update: if isOrgMember(eventId) ||
          (
            isSignedIn() &&
            isTeamRepFor(eventId, request.resource.data.currentHighBidTeamId) &&
            resource.data.status == 'live' &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.currentPlayerId == resource.data.currentPlayerId &&
            (resource.data.currentHighBidTeamId == null
              ? request.resource.data.currentPrice >= resource.data.currentPrice
              : request.resource.data.currentPrice > resource.data.currentPrice) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['currentPrice', 'currentHighBidTeamId', 'currentHighBidderUid', 'lastBid', 'blockDeadlineAt', 'version', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            isTeamRepFor(eventId, resource.data.currentHighBidTeamId) &&
            resource.data.status == 'live' &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.currentPlayerId == resource.data.currentPlayerId &&
            request.resource.data.currentPrice <= resource.data.currentPrice &&
            resource.data.lastBid != null &&
            resource.data.lastBid.teamId == resource.data.currentHighBidTeamId &&
            request.resource.data.lastBid == null &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['currentPrice', 'currentHighBidTeamId', 'currentHighBidderUid', 'lastBid', 'version', 'updatedAt'])
          );
      }

      match /bids/{bidId} {
        allow read: if true;
        allow create: if isOrgMember(eventId) || isTeamRepFor(eventId, request.resource.data.teamId);
        // Append-only, except the one bid a team just withdrew gets flagged so the history shows
        // it crossed out instead of silently vanishing -- see withdrawBid in auctionRealtime.js.
        allow update: if isOrgMember(eventId) ||
          (
            isTeamRepFor(eventId, resource.data.teamId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawn']) &&
            request.resource.data.withdrawn == true
          );
        allow delete: if false;
      }

      // A team-to-team "buy this player from you" offer. The requesting team's rep creates it; the
      // target team's rep (the player's current owner) accepts or declines; the organizer alone
      // finalizes an accepted offer (moves the player + purses), same trust boundary as every other
      // purse-changing action in this app. Letting the organizer finalize -- rather than trusting the
      // accepting rep's client to correctly update a team it doesn't belong to -- keeps all money
      // movement behind the one write path that's already allowed to touch any team/player doc.
      match /swapRequests/{requestId} {
        allow read: if true;
        allow create: if isOrgMember(eventId) ||
          (
            isTeamRepFor(eventId, request.resource.data.requesterTeamId) &&
            request.resource.data.requesterTeamId != request.resource.data.targetTeamId &&
            request.resource.data.status == 'pending' &&
            request.resource.data.createdByUid == request.auth.uid &&
            request.resource.data.price is number && request.resource.data.price >= 0
          );
        allow update: if isOrgMember(eventId) ||
          // Target team accepts or declines an offer addressed to them.
          (
            isTeamRepFor(eventId, resource.data.targetTeamId) &&
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedByUid', 'respondedAt']) &&
            (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')
          ) ||
          // Requester withdraws their own still-pending offer.
          (
            isTeamRepFor(eventId, resource.data.requesterTeamId) &&
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'cancelled'
          );
        allow delete: if isOrgMember(eventId);
      }

      // Who did what, for the organizer to review after the fact. Organizer-only, append-only --
      // never shown to anyone outside the org, and never editable once written.
      match /activityLog/{entryId} {
        allow read, create: if isOrgMember(eventId);
        allow update, delete: if false;
      }
    }
  }
}
